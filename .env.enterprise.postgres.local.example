# Copy to .env.enterprise.postgres.local for one-time database administration.
# Use the pooled, TLS-enabled Neon PostgreSQL URL. Never expose it to the frontend.
DATABASE_URL=

# Set these only while provisioning the first tenant. Remove them afterward.
ENTERPRISE_BOOTSTRAP_TENANT=acme
ENTERPRISE_BOOTSTRAP_TENANT_NAME=Acme
ENTERPRISE_BOOTSTRAP_NAME=Administrator
ENTERPRISE_BOOTSTRAP_EMAIL=admin@example.com
ENTERPRISE_BOOTSTRAP_PASSWORD=
