# Copy to .env.production.local. This file is ignored by Git.
# Override public production values here only when needed.
# REACT_APP_USE_MOCK=false
# APP_BASE_URL=https://api.example.com

# Sentry source map upload. Create a project-scoped token in Sentry.
SENTRY_URL=https://wkylin.sentry.io
# SENTRY_AUTH_TOKEN=

# GitHub OAuth runs in a Vercel Function, not in the frontend build. Configure these
# as Production environment variables in Vercel; do not embed secrets in REACT_APP_*.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_DEMO_CALLBACK_URL=https://pro-react-admin.vercel.app/api/demo/github/callback
# GITHUB_DEMO_APP_URL=https://pro-react-admin.vercel.app/
# GITHUB_SESSION_SECRET=  # Generate with: openssl rand -base64 48
