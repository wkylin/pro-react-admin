    "api:bootstrap": "node --env-file-if-exists=.env.development.local api/enterprise/db-admin.mjs migrate && node --env-file-if-exists=.env.development.local api/enterprise/bootstrap.mjs",
    "start:enterprise:full": "cross-env PROJECT=enterprise node scripts/dev-tracking.mjs",
    "check:project-registry": "node scripts/validate-project-registry.mjs",
    "check:mfe-artifacts": "node scripts/validate-mfe-artifacts.mjs",
    "check:deployment-config": "node scripts/validate-deployment-config.mjs",
    "sync:aliases": "node scripts/sync-path-aliases.mjs",
    "check:aliases": "node scripts/sync-path-aliases.mjs --check",
    "sync:project-contracts": "node scripts/sync-project-contracts.mjs",
    "check:project-contracts": "node scripts/sync-project-contracts.mjs --check",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "prepublishOnly": "pnpm run prepare:lib:release",
    "pub": "cross-env WUI_DIST_TAG=latest pnpm --dir packages/wui-react publish --access public",
    "pub:beta": "cross-env WUI_DIST_TAG=beta pnpm --dir packages/wui-react publish --tag beta --access public",
    "release:lib:patch": "npm --prefix packages/wui-react version patch --no-git-tag-version",
    "release:lib:minor": "npm --prefix packages/wui-react version minor --no-git-tag-version",
    "release:lib:major": "npm --prefix packages/wui-react version major --no-git-tag-version",
    "scanner": "pnpm run test && node scripts/run-sonar-scanner.cjs",
    "depcheck": "node scripts/depcheck.mjs",
    "clean": "pnpm prune && rimraf node_modules/.cache",
    "fresh": "pnpm run clean && rimraf node_modules package-lock.json && pnpm install",
    "nuke": "rimraf node_modules package-lock.json yarn.lock pnpm-lock.yaml && pnpm install",
    "update:pnpm": "pnpm update --latest",
    "check:route-contract": "node scripts/validate-route-contract.mjs",
    "typecheck:lib": "tsc6 --noEmit --emitDeclarationOnly false --project tsconfig.lib.json",
    "generate:docs": "node scripts/generate-component-catalog.mjs && node scripts/generate-project-reference.mjs",
    "check:docs": "node scripts/generate-project-reference.mjs --check && node scripts/validate-docs.mjs",
    "project:list": "node scripts/project-command.mjs list",
    "project:doctor": "node scripts/project-command.mjs doctor",
    "project:create": "node scripts/create-project.mjs",
    "start:enterprise": "node scripts/project-command.mjs dev enterprise",
    "build:enterprise": "node scripts/project-command.mjs build enterprise",
    "sync:deployment": "node scripts/sync-deployment-config.mjs",
    "check:deployment-contracts": "node scripts/sync-deployment-config.mjs --check",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:e2e:enterprise": "playwright test --config=playwright.enterprise.config.ts",
    "test:e2e:enterprise:api": "playwright test --config=playwright.enterprise-api.config.ts",
    "build:enterprise:api": "cross-env REACT_APP_USE_MOCK=false node scripts/project-command.mjs build enterprise --stats",
    "build:enterprise:stats": "node scripts/project-command.mjs build enterprise --stats",
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "typecheck:storybook": "tsc6 --project tsconfig.storybook.json",
    "check:stories": "node scripts/validate-stories.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "vercel:prepare:storybook": "node scripts/prepare-vercel-storybook.mjs",
    "check:pages": "node scripts/validate-pages.mjs"
