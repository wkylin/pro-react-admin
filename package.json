{
  "name": "pro-react-admin",
  "version": "5.1.0",
  "type": "module",
  "private": true,
  "description": "Multi-project React admin framework and microfrontend examples.",
  "keywords": [
    "React",
    "JSX",
    "Webpack",
    "React Router",
    "ESLint",
    "TSX",
    "Bit",
    "Bit.dev",
    "Bit.cloud",
    "TypeScript",
    "Ant Design",
    "Admin Dashboard"
  ],
  "homepage": "https://wkylin.github.io/pro-react-admin",
  "sideEffects": [
    "src/styles/**",
    "**/*.css",
    "**/*.less"
  ],
  "scripts": {
    "devtools": "react-devtools",
    "prebuild": "pnpm run generate:dependencies",
    "optimize:media": "node scripts/optimize-media.mjs",
    "preprod:serve": "pnpm run optimize:media",
    "prebuild:production": "node scripts/prebuild-production.mjs",
    "prebuild:production:zip": "node scripts/prebuild-production.mjs",
    "prebuild:stats": "node scripts/prebuild-production.mjs",
    "ci:quality": "pnpm run lint && pnpm run check:aliases && pnpm run check:import-boundaries && pnpm run check:route-contract && pnpm run check:docs && pnpm run check:i18n && pnpm run typecheck && pnpm run typecheck:boundaries && pnpm run typecheck:api && pnpm run typecheck:lib && pnpm run test && pnpm run test:tooling && pnpm run test:api",
    "prepare": "husky install",
    "dev": "pnpm run start",
    "dev:tracking": "node scripts/dev-tracking.mjs",
    "project:dev": "node scripts/project-command.mjs dev",
    "project:build": "node scripts/project-command.mjs build",
    "mfe:dev": "node scripts/project-command.mjs mfe-dev",
    "mfe:build": "node scripts/project-command.mjs mfe-build",
    "mfe:build:standalone": "node scripts/project-command.mjs mfe-build-standalone",
    "start": "node scripts/dev-tracking.mjs",
    "start:web": "node scripts/project-command.mjs dev",
    "start:projectA": "node scripts/project-command.mjs dev projectA",
    "start:projectB": "node scripts/project-command.mjs dev projectB",
    "start:mf:shell": "node scripts/project-command.mjs mfe-dev shell",
    "start:mf:projectA": "node scripts/project-command.mjs mfe-dev projectA",
    "start:mf:projectB": "node scripts/project-command.mjs mfe-dev projectB",
    "dev:faker": "concurrently -r \"pnpm run start\" \"pnpm run faker\"",
    "build:production": "cross-env SENTRY_SOURCE_MAP=map BUILD_GOAL=production NODE_ENV=production NODE_OPTIONS=--trace-deprecation webpack --config ./webpack/webpack.prod.js --stats-error-details",
    "build:stats": "cross-env STATS_ONLY=1 USE_ANALYZE=1 SENTRY_SOURCE_MAP=no BUILD_GOAL=production NODE_ENV=production webpack --config ./webpack/webpack.prod.js --stats-error-details --json=compilation-stats.json",
    "build:production:zip": "cross-env DIST_ZIP=1 SENTRY_SOURCE_MAP=map BUILD_GOAL=production NODE_ENV=production NODE_OPTIONS=--trace-deprecation webpack --config ./webpack/webpack.prod.js --stats-error-details",
    "build:production:projectA": "node scripts/project-command.mjs build projectA",
    "build:production:projectB": "node scripts/project-command.mjs build projectB",
    "build:mf:shell": "node scripts/project-command.mjs mfe-build shell",
    "build:mf:projectA": "node scripts/project-command.mjs mfe-build projectA",
    "build:mf:projectB": "node scripts/project-command.mjs mfe-build projectB",
    "build:mf:projectA:standalone": "node scripts/project-command.mjs mfe-build-standalone projectA",
    "build:mf:projectB:standalone": "node scripts/project-command.mjs mfe-build-standalone projectB",
    "build:mf:vercel": "node scripts/build-mfe.mjs",
    "vercel-build": "pnpm run build:mf:vercel",
    "vercel:prepare:enterprise": "node scripts/prepare-vercel-enterprise.mjs",
    "build:production:zip:projectA": "cross-env PROJECT=projectA DIST_ZIP=1 SENTRY_SOURCE_MAP=map BUILD_GOAL=production NODE_ENV=production NODE_OPTIONS=--trace-deprecation webpack --config ./webpack/webpack.prod.js --stats-error-details",
    "build:production:zip:projectB": "cross-env PROJECT=projectB DIST_ZIP=1 SENTRY_SOURCE_MAP=map BUILD_GOAL=production NODE_ENV=production NODE_OPTIONS=--trace-deprecation webpack --config ./webpack/webpack.prod.js --stats-error-details",
    "build:test": "cross-env SENTRY_SOURCE_MAP=no BUILD_GOAL=test NODE_ENV=production webpack --config ./webpack/webpack.prod.js --stats-error-details",
    "build:dev": "cross-env SENTRY_SOURCE_MAP=no BUILD_GOAL=dev NODE_ENV=production webpack --config ./webpack/webpack.prod.js --stats-error-details",
    "prod:serve": "cross-env SENTRY_SOURCE_MAP=no BUILD_SERVE=prod BUILD_GOAL=production NODE_ENV=production webpack --config ./webpack/webpack.prod.js --stats-error-details",
    "prod:serve:projectA": "cross-env PROJECT=projectA SENTRY_SOURCE_MAP=no BUILD_SERVE=prod BUILD_GOAL=production NODE_ENV=production webpack --config ./webpack/webpack.prod.js --stats-error-details",
    "prod:serve:projectB": "cross-env PROJECT=projectB SENTRY_SOURCE_MAP=no BUILD_SERVE=prod BUILD_GOAL=production NODE_ENV=production webpack --config ./webpack/webpack.prod.js --stats-error-details",
    "prod:serve:debug": "cross-env DEBUG_PROD=1 pnpm run prod:serve",
    "dev:serve": "cross-env SENTRY_SOURCE_MAP=no BUILD_SERVE=prod BUILD_GOAL=dev NODE_ENV=production webpack --config ./webpack/webpack.prod.js --stats-error-details",
    "test:serve": "cross-env SENTRY_SOURCE_MAP=no BUILD_SERVE=prod BUILD_GOAL=test NODE_ENV=production webpack --config ./webpack/webpack.prod.js --stats-error-details",
    "analyze:build": "cross-env SENTRY_SOURCE_MAP=no BUILD_GOAL=production NODE_ENV=production USE_ANALYZE=1 webpack --config ./webpack/webpack.prod.js --stats-error-details --profile --json=compilation-stats.json",
    "analyze:stats": "pnpm exec webpack --profile --json=stats.json",
    "clean:dist:current": "node scripts/dist-tools.mjs clean",
    "serve:dist": "node scripts/dist-tools.mjs serve --port 5000",
    "serve:dist:test": "node scripts/dist-tools.mjs serve --port 7000",
    "serve:prod": "pnpm run clean:dist:current && pnpm run prod:serve && pnpm run serve:dist",
    "serve:dev": "pnpm run clean:dist:current && pnpm run dev:serve && pnpm run serve:dist",
    "serve:test": "pnpm run clean:dist:current && pnpm run test:serve && pnpm run serve:dist:test",
    "http:dev": "pnpm run clean:dist:current && pnpm run dev:serve && pnpm run http-server",
    "http:prod": "pnpm run clean:dist:current && pnpm run prod:serve && pnpm run http-server",
    "http:test": "pnpm run clean:dist:current && pnpm run test:serve && pnpm run http-server",
    "http-server": "node scripts/dist-tools.mjs http -- -p 9090 --proxy https://my-json-server.typicode.com -o --cors --log-ip --gzip",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "faker": "nodemon faker/index.js",
    "generate:dependencies": "node scripts/generate-dependencies.cjs",
    "test": "pnpm run test:coverage",
    "test:jest": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:mfe": "playwright test --config=playwright.mfe.config.ts",
    "test:watch": "jest --watch",
    "test:report": "pnpm exec playwright show-report",
    "lint:fix": "pnpm run eslint:fix && pnpm run stylelint:fix && pnpm run prettier:fix",
    "lint": "pnpm run eslint && pnpm run stylelint && pnpm run prettier:check",
    "lint:errors": "eslint --cache --quiet \"src/**/*.{js,jsx,ts,tsx}\"",
    "stylelint": "stylelint \"src/**/*.(less|css|scss)\" --custom-syntax postcss-less",
    "stylelint:fix": "stylelint \"src/**/*.(less|css|scss)\" --fix --custom-syntax postcss-less",
    "prettier:check": "prettier --check \"src/**/*\" --end-of-line auto --ignore-unknown",
    "prettier:fix": "prettier --write \"src/**/*\" --end-of-line auto --ignore-unknown",
    "prettier:fix:all": "prettier --write . --end-of-line auto --ignore-unknown",
    "eslint": "eslint --cache \"src/**/*.{js,jsx,ts,tsx}\"",
    "eslint:fix": "eslint --fix --cache \"src/**/*.{js,jsx,ts,tsx}\"",
    "markdownlint": "markdownlint *.md",
    "markdownlint:fix": "markdownlint --fix *.md",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major",
    "push:tags": "git push --follow-tags origin main",
    "process": "node webpack/process",
    "predeploy": "pnpm run build:production",
    "deploy": "node scripts/deploy-gh.js",
    "deploy:only": "gh-pages -d dist",
    "clean:lock": "rimraf  package-lock.json yarn.lock pnpm-lock.yaml",
    "clean:dist": "rimraf  ./dist",
    "clean:modules": "rimraf  node_modules",
    "js-analyzer": "js-analyzer --root ./",
    "storybook": "cross-env BABEL_ENV=storybook storybook dev -p 6006",
