# Copy to .env.enterprise.production.local on the persistent API host.
# Point this domain's DNS at the host and allow inbound TCP 80/443.
API_DOMAIN=api.example.com
# Exact browser origin(s), comma-separated; no trailing slash or wildcard.
CORS_ORIGINS=https://your-enterprise-project.vercel.app
NODE_ENV=production
ENTERPRISE_ENABLED=true
ENTERPRISE_DB_PATH=/data/enterprise.sqlite
TRACKING_STORE=memory
TRACKING_API_PORT=5200

# First-time tenant provisioning only. Replace the password before running.
# Remove these five entries after the bootstrap command succeeds.
ENTERPRISE_BOOTSTRAP_TENANT=acme
ENTERPRISE_BOOTSTRAP_TENANT_NAME=Acme
ENTERPRISE_BOOTSTRAP_NAME=Administrator
ENTERPRISE_BOOTSTRAP_EMAIL=admin@example.com
ENTERPRISE_BOOTSTRAP_PASSWORD=
