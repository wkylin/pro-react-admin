{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "packages/wui-react/dist/types",
    "rootDir": "."
  },
  "include": ["src/lib/**/*", "packages/wui-react/src/**/*", "src/**/*.d.ts", "typings/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "packages/wui-react/dist",
    "coverage",
    "packages/wui-react/src/**/*.stories.*",
    "packages/wui-react/src/**/*.test.*",
    "packages/wui-react/src/**/*.spec.*"
  ]
}
