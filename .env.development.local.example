# Copy to .env.development.local; local overrides are ignored by Git.
# Shared .env already enables browser demo login.
# Uncomment these only when connecting a separate API.
# REACT_APP_USE_MOCK=false
# APP_BASE_URL=http://127.0.0.1:5200
TRACKING_STORE=memory
# Full-stack startup uses this as the first API port and increments if it is busy.
TRACKING_API_PORT=5200
# The enterprise start scripts enable their local API automatically.
ENTERPRISE_ENABLED=false

# Optional GitHub login for demo accounts only. Create a GitHub OAuth App with
# Authorization callback URL matching the callback below exactly. Keep the secret local.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_DEMO_CALLBACK_URL=http://localhost:8080/api/demo/github/callback
# GITHUB_DEMO_APP_URL=http://localhost:8080/
# GITHUB_SESSION_SECRET=  # Generate with: openssl rand -base64 48

# Custom tenant: set REACT_APP_USE_MOCK=false, provision with api:bootstrap,
# then run either enterprise start script. Without custom settings, the starter
# creates an isolated local demo SQLite with the credentials shown on the login page.
# Set your own password (12..256 characters), then run pnpm run api:bootstrap.
# Remove these five bootstrap settings after provisioning the tenant.
# ENTERPRISE_BOOTSTRAP_TENANT=acme
# ENTERPRISE_BOOTSTRAP_TENANT_NAME=Acme
# ENTERPRISE_BOOTSTRAP_NAME=Administrator
# ENTERPRISE_BOOTSTRAP_EMAIL=admin@example.com
# ENTERPRISE_BOOTSTRAP_PASSWORD=

# Optional overrides for an API running elsewhere (explicit targets do not follow port fallback):
# ENTERPRISE_API_TARGET=http://127.0.0.1:5200
# TRACKING_API_TARGET=http://127.0.0.1:5200
# ENTERPRISE_DB_PATH=/absolute/path/to/enterprise.sqlite
# To enable enterprise login authenticators, generate once with `openssl rand -hex 32`.
# Keep this server-only key when upgrading or restoring the database.
# ENTERPRISE_TOTP_KEY=
