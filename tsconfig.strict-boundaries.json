{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["node", "jest", "@testing-library/jest-dom"]
  },
  "include": [
    "src/app/routing/utils/index.tsx",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/platform/**/*.ts",
    "src/platform/**/*.tsx",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx",
    "typings/**/*.d.ts",
    "src/app/model/**/*.ts",
    "src/app/model/**/*.tsx",
    "src/app/bootstrap/renderApp.tsx",
    "src/app/bootstrap/providers/**/*.tsx",
    "src/app/layouts/proTabs/context.tsx",
    "src/app/layouts/proTabs/index.tsx",
    "src/app/layouts/proSider/index.tsx",
    "src/app/layouts/registry.ts",
    "src/app/layouts/types.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/wui-react/dist",
    "coverage",
    "src/shared/**/*.test.ts",
    "src/shared/**/*.test.tsx",
    "src/shared/**/*.spec.ts",
    "src/shared/**/*.spec.tsx"
  ]
}
