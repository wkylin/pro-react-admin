{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30
    },
    "api/resource-stream.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/:first/:rest*", "destination": "/api/:first" }
  ]
}
