{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": [
    "api/**/*.ts",
    "../../server/enterprise/**/*.mts",
    "../../server/enterprise/router.cjs",
    "../../src/platform/auth/model/accessDecision.ts"
  ]
}
